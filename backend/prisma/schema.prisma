generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  emailVerified Boolean  @default(false)
  emailVerificationToken String? @unique
  emailVerificationExpiresAt DateTime?
  mobileNumber String?
  fullName     String?
  address      String?
  birthDate    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  events       Event[]
  calendarCredentials CalendarSyncCredential[]
  sentShareInvites     ShareInvite[] @relation("ShareInviteSender")
  receivedShareInvites ShareInvite[] @relation("ShareInviteRecipient")
}

model CalendarSyncCredential {
  id           String   @id @default(cuid())
  userId       String
  provider     String
  refreshToken String
  scope        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([userId])
}

model Event {
  id                    String    @id @default(cuid())
  userId                String
  title                 String
  people                String
  ageAsOfToday          Int?
  eventDateTime         DateTime
  eventEndDateTime      DateTime?
  reminderDateTime      DateTime
  reminderTimeZone      String?
  eventAllDay           Boolean
  reminderAllDay        Boolean
  frequency             String
  reminderMode          String?
  notes                 String?
  notified              Boolean?  @default(false)
  lastReminderTriggeredAt DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  reminders EventReminder[]
  shareInvites ShareInvite[]

  @@index([userId])
}

model EventReminder {
  id             String   @id @default(cuid())
  eventId        String
  reminderDateTime DateTime
  notes          String?
  notified       Boolean? @default(false)
  lastTriggeredAt DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([reminderDateTime])
}

model ShareInvite {
  id              String   @id @default(cuid())
  senderUserId    String
  recipientUserId String
  sourceEventId   String
  message         String?
  channels        String?
  acceptedAt      DateTime?
  dismissedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  sender    User  @relation("ShareInviteSender", fields: [senderUserId], references: [id], onDelete: Cascade)
  recipient User  @relation("ShareInviteRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade)
  sourceEvent Event @relation(fields: [sourceEventId], references: [id], onDelete: Cascade)

  @@index([recipientUserId, acceptedAt, dismissedAt, createdAt])
  @@index([senderUserId, createdAt])
  @@unique([recipientUserId, sourceEventId])
}
