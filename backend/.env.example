# Local Postgres (Docker)
DATABASE_URL="postgresql://specialdate:specialdate@localhost:5432/special_date_reminder?schema=public"
PORT=4000

# Email verification
EMAIL_VERIFICATION_BASE_URL="http://localhost:4000"
EMAIL_FROM="no-reply@special-date-reminder.local"
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE=false
SUPPORT_EMAIL="support@special-date-reminder.local"

# SMS provider (Twilio)
SMS_PROVIDER="noop"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# Google Places address autocomplete (used by /google/places/* endpoints)
# Set either GOOGLE_PLACES_API_KEY (preferred) or GOOGLE_MAPS_API_KEY.
GOOGLE_PLACES_API_KEY=""
GOOGLE_MAPS_API_KEY=""

# Google Calendar sync (backend-managed OAuth credentials)
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
GOOGLE_OAUTH_REDIRECT_URI=""
APP_RETURN_URL="http://localhost:8081"
# Optional fallback if user does not provide calendar ID in account settings
GOOGLE_CALENDAR_ID=""

# Outlook Calendar sync (backend-managed OAuth credentials)
OUTLOOK_OAUTH_CLIENT_ID=""
OUTLOOK_OAUTH_CLIENT_SECRET=""
OUTLOOK_OAUTH_REDIRECT_URI=""
# Optional authority/tenant selector. Examples: "common", "organizations", "consumers", or a tenant GUID.
OUTLOOK_OAUTH_TENANT="common"

